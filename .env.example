# 이 파일을 .env 로 복사한 뒤 쓰세요. (.env는 gitignore 처리돼 있습니다)
#
#   cp .env.example .env
#
# ⚠️ VITE_ 접두사가 붙은 값은 빌드 시 브라우저 번들에 그대로 박힙니다.
#    누구나 개발자도구로 읽을 수 있으니 비밀값은 절대 넣지 마세요.
#    개인 설정이 필요하면 .env.local 을 쓰세요 (*.local 도 gitignore 처리됨).

# ---------------------------------------------------------------- 백엔드 주소
# 백엔드(AICE-BE)는 `uvicorn app.main:app --reload`로 8000 포트에 뜹니다.
# https://github.com/AICE-GACHON/AICE-BE
#
# ⚠️ 이 값이 비어 있으면 src/api/*.js가 전부 mock 응답으로 폴백합니다 —
#    백엔드가 꺼져 있어도 화면이 멀쩡히 동작해서 알아채기 어렵습니다.
#    "분석은 되는데 DB에 아무것도 안 쌓인다" 싶으면 먼저 이 값을 확인하세요.
#
# 백엔드 CORS 허용 목록(app/core/config.py CORS_ORIGINS)에 이 개발 서버
# 주소(5173~5175)가 이미 들어 있습니다.
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------- 구글 로그인
# Google Cloud Console(APIs & Services > Credentials)에서 만든 OAuth 2.0
# 클라이언트 ID(웹 애플리케이션). 형식은 `<숫자>-<문자열>.apps.googleusercontent.com`.
#
# 백엔드(AICE-BE)의 GOOGLE_CLIENT_ID와 **똑같은 값**이어야 합니다. 프론트는 이
# 값으로 구글에서 id_token을 받고, 백엔드는 그 토큰의 audience가 자기 쪽
# GOOGLE_CLIENT_ID와 맞는지 검사합니다 — 다르면 POST /api/auth/google이 401입니다.
#
# 비어 있으면 로그인 버튼이 "Google로 계속하기 (설정 필요)" 비활성 상태로만
# 보입니다 (src/auth/GoogleLoginButton.jsx).
#
# ⚠️ 이 값은 번들에 박히지만 비밀값이 아닙니다. 대신 Console의
#    **승인된 JavaScript 원본**에 이 프론트를 띄우는 origin을 전부 등록해야 합니다.
#    등록되지 않은 origin에서는 버튼이 아예 동작하지 않습니다.
#      - 개발:  http://localhost:5173  (포트 충돌 시 5174, 5175도)
#      - 배포:  https://<서비스 도메인>
VITE_GOOGLE_CLIENT_ID=
